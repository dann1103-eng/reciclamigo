# Supabase: Project Settings → API Keys (llaves nuevas: publishable y secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca la expongas al navegador ni la subas al repo.
SUPABASE_SECRET_KEY=

# Demo
NEXT_PUBLIC_DEMO_MODE=true
# Contraseña común de las cuentas demo (la usa el selector de rol y npm run seed)
DEMO_PASSWORD=
# Token para POST /demo/reset?token=...
DEMO_RESET_TOKEN=
# Dominio público (el QR del certificado apunta aquí)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
