# Supabase: Project Settings → API Keys (legacy: anon y service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas al navegador ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Demo
NEXT_PUBLIC_DEMO_MODE=true
# Contraseña común de las cuentas demo (la usa el selector de rol y npm run seed)
DEMO_PASSWORD=
# Token para POST /demo/reset?token=...
DEMO_RESET_TOKEN=
# Dominio público (el QR del comprobante y el de la insignia apuntan aquí)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Avisos push de la PWA (Web Push, sin servicio de pago).
# Genera las llaves una vez con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Solo servidor.
VAPID_PRIVATE_KEY=
# Contacto del remitente (mailto: o URL), lo piden los servicios de push.
VAPID_SUBJECT=mailto:hola@reciclamigo.app

# Vercel Cron: protege /api/cron/* (Vercel lo manda como "Authorization: Bearer <valor>").
CRON_SECRET=
